{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "expand.hlr_to_llrs response",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {"type": "string", "minLength": 10},
          "function": {"type": "string", "minLength": 1},
          "traces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "ref"],
              "properties": {
                "target": {"type": "string"},
                "ref": {"type": "string"},
                "name": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
