        "properties": {
          "target": {"type": "string", "enum": ["SDD", "PVD", "HLR", "LLR"]},
          "ref": {"type": "string", "minLength": 1},
          "name": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
