<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="g_version" for="graph" attr.name="format-version" attr.type="int"/>
  <key id="g_unresolved" for="graph" attr.name="unresolved-calls" attr.type="int"/>
  <key id="n_name" for="node" attr.name="name" attr.type="string"/>
