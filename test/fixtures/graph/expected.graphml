  <key id="n_fanout" for="node" attr.name="fan-out" attr.type="int"/>
  <key id="n_fanin" for="node" attr.name="fan-in" attr.type="int"/>
  <key id="n_address" for="node" attr.name="address-taken" attr.type="boolean"/>
